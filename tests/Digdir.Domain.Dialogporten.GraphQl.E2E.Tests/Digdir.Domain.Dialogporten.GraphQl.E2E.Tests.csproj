<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Tests exercise the experimental authorizationContext SDK surface on purpose. -->
        <NoWarn>$(NoWarn);DPEXP001</NoWarn>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
        <!-- StrawberryShake.Transport.Http only requires WebUtilities >= 10.0.0, which NuGet resolves to 10.0.0.
             This direct reference sets the version for this project and the projects that reference it. -->
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="StrawberryShake.Server" Version="16.7.5" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Digdir.Library.Dialogporten.E2E.Common\appsettings*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Digdir.Library.Dialogporten.E2E.Common\Digdir.Library.Dialogporten.E2E.Common.csproj" />
    </ItemGroup>

</Project>
