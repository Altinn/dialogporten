<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The WebApiClient SDK projects multi-target net10.0;net9.0;net8.0 with #if NET8_0 code
             paths. Clear the root-inherited single TargetFramework and test the oldest and newest
             TFMs so both sides of those conditionals are covered. -->
        <TargetFramework />
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <!-- The NET8_0-conditional code paths are fixed at compile time, so the net8.0 test
             assembly may run on a newer runtime on machines without the .NET 8 runtime installed. -->
        <RollForward Condition="'$(TargetFramework)' == 'net8.0'">Major</RollForward>
        <!-- Tests exercise the experimental authorizationContext SDK surface on purpose. -->
        <NoWarn>$(NoWarn);DPEXP001</NoWarn>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="coverlet.collector" Version="10.0.1" />
        <PackageReference Include="NSubstitute" Version="5.3.0"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <!-- Provides System.Buffers.Text.Base64Url, which is only in the BCL from .NET 9. -->
        <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
        <!-- The .NET 10 SDK bundles no net8.0 apphost, so it emits an implicit PackageDownload for
             one. A locked mode restore discards implicit downloads, leaving the build to fail on a
             missing apphost whenever the NuGet cache lacks the exact version the SDK asks for. An
             explicit PackageDownload survives locked mode. The version must match the net8.0
             AppHostPackVersion in the SDK's Microsoft.NETCoreSdk.BundledVersions.props, and so
             moves together with the dotnet-sdk pin in global.json. -->
        <PackageDownload Include="Microsoft.NETCore.App.Host.$(NETCoreSdkPortableRuntimeIdentifier)" Version="[8.0.31]" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\WebApiClient\Digdir.Library.Dialogporten.WebApiClient.Common\Digdir.Library.Dialogporten.WebApiClient.Common.csproj" />
        <ProjectReference Include="..\..\src\WebApiClient\Digdir.Library.Dialogporten.WebApiClient\Digdir.Library.Dialogporten.WebApiClient.csproj"/>
        <ProjectReference Include="..\..\src\WebApiClient\Digdir.Library.Dialogporten.WebApiClient.ServiceOwner\Digdir.Library.Dialogporten.WebApiClient.ServiceOwner.csproj"/>
        <ProjectReference Include="..\..\src\WebApiClient\Digdir.Library.Dialogporten.WebApiClient.EndUser\Digdir.Library.Dialogporten.WebApiClient.EndUser.csproj"/>
    </ItemGroup>

</Project>
