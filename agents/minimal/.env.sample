# Your Git identity, for the agent's commits. It enters the agent as plain text.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com
# A fine-grained GitHub token with access to Altinn/dialogporten, to push branches and open pull requests. It stays on your machine.
GITHUB_TOKEN=
# The AT23 APIM subscription key, Infrastructure:Altinn:SubscriptionKey in your user secrets. Some Altinn APIs answer 401 without it. It stays on your machine.
ALTINN_AT23_SUBSCRIPTION_KEY=
# Optional: the test token generator user for the E2E tests, as in the dialogporten-bruno .env. It stays on your machine.
E2E_TOKEN_GENERATOR_USER=
# Optional: the test token generator password for the E2E tests. It stays on your machine.
E2E_TOKEN_GENERATOR_PASSWORD=
# The client ID of an AT23 Maskinporten test client, or none. It enters the agent as plain text.
MASKINPORTEN_AT23_CLIENT_ID=none
# The base64-encoded JWK of that client, or none. The apps sign with it, so the real key enters the agent: use a dedicated test client.
MASKINPORTEN_AT23_ENCODED_JWK=none
