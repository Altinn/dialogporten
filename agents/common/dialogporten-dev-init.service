[Unit]
Description=Prepare local Dialogporten development: HTTPS dev certificate, Ed25519 key pair and user secrets
# After the clone, so its CPU-heavy first run of the SDK does not slow the clone and the harness checks at boot. The
# clone's unit is `Type=exec`, so this orders the unit only after the clone has started; the script waits for the rest.
After=network-online.target agent-workspace-init.service
Wants=network-online.target

[Service]
# `Type=exec`, as the clone's unit, completes the start job once the script has started, so the wait for the clone and
# the SDK's first run stay out of the boot transaction and `systemctl is-system-running --wait` does not wait for them.
# The unit stays active while the script runs: `systemctl show -P SubState` is `running` until it is done, then `exited`.
Type=exec
RemainAfterExit=yes
PassEnvironment=MASKINPORTEN_AT23_CLIENT_ID MASKINPORTEN_AT23_ENCODED_JWK
ExecStart=/usr/local/libexec/agent-dialogporten-dev-init

[Install]
WantedBy=multi-user.target
